{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiosk Desktop Viewer",
  "version": "0.1.0",
  "identifier": "com.kiosk.desktopviewer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kiosk Desktop Viewer",
        "url": "index.html",
        "width": 1280,
        "height": 760,
        "resizable": true,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
